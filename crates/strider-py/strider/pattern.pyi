"""Type stubs for strider.pattern."""

from __future__ import annotations

from typing import Any, Callable, Optional, Union

class Capture:
    def __init__(self) -> None: ...

class PartialMatch:
    """Proxy passed to `.when(predicate)`.  Read captures bound so far
    via `uint(key)` / `int(key)` / `bool(key)` / `float_bits(key)` /
    `has(key)` / `m[key]` / `key in m` (key is `Capture` or `str`).
    """

    def uint(self, key: Any) -> Optional[int]: ...
    def int(self, key: Any) -> Optional[int]: ...
    def bool(self, key: Any) -> Optional[bool]: ...
    def float_bits(self, key: Any) -> Optional[int]: ...
    def has(self, key: Any) -> bool: ...
    def __getitem__(self, key: Any) -> Any: ...
    def __contains__(self, key: Any) -> bool: ...

class Pat:
    def capture(self, c: Capture) -> Pat: ...
    def cap(self, name: str) -> Pat: ...
    def when(self, f: Callable[[PartialMatch], bool]) -> Pat: ...
    def ordered(self) -> Pat: ...

# All builders accept str | Capture | Pat (or one of the typed
# builders below) for sub-patterns.  The typed-builder variants are
# auto-finalised at field-setter call sites — see `PyCallPat`'s
# `into_pat()` for the explicit form.
PatLike = Union[str, Capture, Pat, "CallPat"]

# ── Typed family-dispatcher builder types ──────────────────────────────

class IntBinaryPat:
    def ordered(self) -> Pat: ...
    def capture(self, c: Capture) -> Pat: ...
    def cap(self, name: str) -> Pat: ...
    def when(self, f: Callable[[PartialMatch], bool]) -> Pat: ...
    def into_pat(self) -> Pat: ...

class BoolBinaryPat:
    def ordered(self) -> Pat: ...
    def capture(self, c: Capture) -> Pat: ...
    def cap(self, name: str) -> Pat: ...
    def when(self, f: Callable[[PartialMatch], bool]) -> Pat: ...
    def into_pat(self) -> Pat: ...

class FloatBinaryPat:
    def ordered(self) -> Pat: ...
    def capture(self, c: Capture) -> Pat: ...
    def cap(self, name: str) -> Pat: ...
    def when(self, f: Callable[[PartialMatch], bool]) -> Pat: ...
    def into_pat(self) -> Pat: ...

class CallPat:
    """Builder for `Call` node patterns.  Returned by `call()`.

    Field-setter methods (`at`, `target`, `arg`, `ret_output`) return
    the same builder for chaining; finaliser methods (`capture`,
    `cap`, `when`, `into_pat`) return a `Pat`.

    `Graph.find_all` / `Graph.rewrite` accept un-finalised builders
    via `PatLike`, so `g.find_all(call().arg(0, int_const(8)))` works
    without an explicit `.into_pat()`.
    """
    def at(self, addr: int) -> "CallPat": ...
    def target(self, p: PatLike) -> "CallPat": ...
    def arg(self, idx: int, p: PatLike) -> "CallPat": ...
    def ret_output(self, idx: int, p: PatLike) -> "CallPat": ...
    def capture(self, c: Capture) -> Pat: ...
    def cap(self, name: str) -> Pat: ...
    def when(self, f: Callable[[PartialMatch], bool]) -> Pat: ...
    def into_pat(self) -> Pat: ...

