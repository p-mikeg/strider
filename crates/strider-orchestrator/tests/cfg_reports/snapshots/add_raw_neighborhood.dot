digraph "G" {
  graph [
    rankdir="TB",
    bgcolor="#1e1e1e",
    fontcolor="white",
  ];

  node [
    shape="box",
    style="filled,rounded",
    fillcolor="#2d2d2d",
    color="#888888",
    fontcolor="white",
    fontname="monospace",
    margin="0.2",
  ];

  edge [
    color="#aaaaaa",
    fontcolor="white",
    penwidth="1.2",
  ];

  "n0" [label="n0  Entry\nout: Control", shape="box", color="#ffcc00", penwidth="2.5"];
  "n1" [label="n1  Return", shape="box"];
  "n0" -> "n1" [label="0:0"];
  "n11" -> "n1" [label="0:1"];
  "n6" -> "n1" [label="0:2"];
  "n5" -> "n1" [label="0:3"];
  "n4" -> "n1" [label="0:4"];
  "n3" -> "n1" [label="0:5"];
  "n2" -> "n1" [label="0:6"];
  "n2" [label="n2  InitialVar(#11 %0x1200:16)\nout: Typed(I128)", shape="box"];
  "n3" [label="n3  InitialVar(#10 %0x1110:10)\nout: Typed(I80)", shape="box"];
  "n4" [label="n4  InitialVar(#9 %0x1100:10)\nout: Typed(I80)", shape="box"];
  "n5" [label="n5  InitialVar(#1 %0x8:4)\nout: Typed(I32)", shape="box"];
  "n6" [label="n6  IntBinaryOp(Add)\nout: Typed(I32)", shape="box"];
  "n12" -> "n6" [label="0:0"];
  "n7" -> "n6" [label="0:1"];
  "n7" [label="n7  Load(VnSpace { shortcut: 'r' })\nout: Typed(I32)\nsp[4]\n[arg 0]", shape="box"];
  "n11" -> "n7" [label="0:0"];
  "n8" -> "n7" [label="0:1"];
  "n8" [label="n8  IntBinaryOp(Add)\nout: Typed(I32)", shape="box"];
  "n10" -> "n8" [label="0:0"];
  "n9" -> "n8" [label="0:1"];
  "n9" [label="n9  IntConst(#0)\n= 4\nout: Typed(I32)", shape="box"];
  "n10" [label="n10  InitialVar(#2 %0x10:4)\nout: Typed(I32)", shape="box"];
  "n11" [label="n11  InitialMemory\nout: Memory", shape="box"];
  "n12" [label="n12  Load(VnSpace { shortcut: 'r' })\nout: Typed(I32)\nsp[8]\n[arg 1]", shape="box"];
  "n11" -> "n12" [label="0:0"];
  "n13" -> "n12" [label="0:1"];
  "n13" [label="n13  IntBinaryOp(Add)\nout: Typed(I32)", shape="box"];
  "n10" -> "n13" [label="0:0"];
  "n14" -> "n13" [label="0:1"];
  "n14" [label="n14  IntConst(#1)\n= 8\nout: Typed(I32)", shape="box"];
}
