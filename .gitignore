/target
fixtures/out/**/*.o
# The object files the tests name ARE committed, through Git LFS: without them
# the ET_REL loader tests skip and `ppc_rel32_patches_a_rodata_jump_table`
# panics on a fresh clone.
!fixtures/out/*/tzcount.o
!fixtures/out/*/switch.o
!fixtures/out/*/globals.o
!fixtures/out/*/elf_relocs.o
!fixtures/out/x64/memory.o
!fixtures/out/ppc32be/switch_masked_loop.o
fixtures/vmlinux
/.worktrees
/.venv
__pycache__/
*.pyc
.pytest_cache/
*.so
*.dylib
*.dll

